@import "catppuccin-mocha.rasi"
* {
    font: "JetBrainsMono Nerd Font 11";
}
window {
    background-color: @bg0;
    border:           2px;
    border-color:     @blue;
    border-radius:    10px;
    width:            40%;
}
mainbox {
    background-color: transparent;
    children:         [ inputbar, listview ];
    padding:          12px;
    spacing:          8px;
}
inputbar {
    background-color: @bg1;
    border-radius:    8px;
    children:         [ prompt, entry ];
    padding:          8px 12px;
    spacing:          8px;
}
prompt {
    text-color: @mauve;
}
entry {
    placeholder:       "Search...";
    placeholder-color: @bg4;
}
listview {
    background-color: transparent;
    lines:            8;
    scrollbar:        false;
    spacing:          4px;
}
element {
    background-color: transparent;
    border-radius:    6px;
    orientation:      horizontal;
    padding:          8px 12px;
    spacing:          10px;
}
element selected {
    background-color: @bg2;
    text-color:       @mauve;
}
element-text {
    background-color: transparent;
    text-color:       inherit;
}
element-icon {
    background-color: transparent;
    size:             1.2em;
}
