#!/usr/bin/env bash
export PATH="$HOME/.local/bin:$PATH"
STATE="$HOME/.local/state/shell-switch"
mkdir -p "$(dirname "$STATE")"
target="${1:-$(cat "$STATE" 2>/dev/null || echo classic)}"

pkill -x waybar
pkill -x mako
pkill -f "caelestia shell"
pkill -x quickshell
pkill -x qs
pkill -f vitreus-keep
pkill -x pleamar
sleep 0.5

run() { setsid "$@" >/dev/null 2>&1 </dev/null & }

case "$target" in
classic)
  run waybar
  run mako
  pgrep -x awww-daemon >/dev/null || {
    run awww-daemon
    sleep 0.3
  }
  awww img ~/Media/Pictures/Wallpapers/Fantasy.jpg
  ;;
caelestia)
  run caelestia shell -d
  ;;
vitreus)
  pgrep -x awww-daemon >/dev/null || run awww-daemon
  run vitreus-keep "$HOME/.config/pleamar/shells/vitreus/vitreus.plm" "$HOME/.local/share/pleamar/vitreus/vitreus.log"
  ;;
*)
  echo "unknown shell: $target" >&2
  exit 1
  ;;
esac
echo "$target" >"$STATE"
